DIG_LLM_ENABLED=true

# Provider: local (Gemma/MLX) or openrouter
# DIG_LLM_PROVIDER=local
# DIG_LLM_PROVIDER=openrouter

# Local Gemma (default)
DIG_LLM_BASE_URL=http://127.0.0.1:11434/v1
DIG_LLM_MODEL=mlx-community/gemma-4-e4b-it-4bit
DIG_LLM_TIMEOUT_MS=120000

# When local is down/busy, fall back to OpenRouter free Nemotron (needs key)
DIG_LLM_FALLBACK=openrouter
# OPENROUTER_API_KEY=

# Force OpenRouter as primary instead:
# DIG_LLM_PROVIDER=openrouter
# DIG_LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# DIG_LLM_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# For Qwen bulk JSON stages (avoid empty content): DIG_LLM_REASONING_EFFORT=none
# Async enrichment (DIG-009, default on when LLM enabled): DIG_LLM_ASYNC=true
# DIG_LLM_BULK_MODEL=qwen/qwen3.7-flash
# DIG_LLM_QUALITY_MODEL=openai/gpt-5.6-luna
# Unified text+vision quality eval: npm run llm:quality-eval (see knowledge/llm-quality-eval.md)
# OPENROUTER_API_KEY=
