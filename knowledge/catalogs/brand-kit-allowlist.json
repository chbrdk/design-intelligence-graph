          "url": "https://brand.pulumi.com/brand-assets/logos/png/pulumi-logo-horizontal-color-light.png",
          "filename": "pulumi-logo-horizontal-color-light.png",
          "role": "logo"
        },
        {
          "url": "https://brand.pulumi.com/brand-assets/logos/png/pulumi-logo-horizontal-color-dark.png",
          "filename": "pulumi-logo-horizontal-color-dark.png",
          "role": "logo"
        },
        {
          "url": "https://brand.pulumi.com/brand-assets/logos/png/pulumi-icon-rounded-light.png",
          "filename": "pulumi-icon-rounded-light.png",
          "role": "icon"
        }
      ]
    },
    {
      "id": "creativecommons",
      "name": "Creative Commons",
      "guidelinesUrl": "https://creativecommons.org/mission/downloads/",
      "hostAllowlist": ["mirrors.creativecommons.org", "creativecommons.org"],
      "licenseClass": "connector_tos",
      "craftEligibleDefault": false,
      "industryTags": ["nonprofit", "licensing", "open_culture"],
      "assets": [
        {
          "url": "https://mirrors.creativecommons.org/presskit/icons/cc.large.png",
