    "lookConditionedMapping": "fixtures/design-references/look-conditioned-mapping.json",
    "designReferenceEvalScenario": "fixtures/eval/design-reference-hero/scenario.json",
    "designReferenceEmbeddings": {
      "canonicalVersion": "0.1.0",
      "defaultProvider": "hashing",
