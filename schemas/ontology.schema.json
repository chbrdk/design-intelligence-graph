{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/ontology.schema.json",
  "title": "DIG-002 Ontology Artifact",
  "type": "object",
  "required": ["schema_version", "ontology_version", "generated_at", "viewports"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "ontology_version": { "const": "0.1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "viewports": { "type": "array", "items": { "$ref": "#/$defs/viewportOntology" } }
  },
  "$defs": {
    "viewportOntology": {
      "type": "object",
      "required": ["ontology_version", "viewport_capture_id", "viewport_name", "page_entity_id", "entities", "relationships"],
      "properties": {
        "ontology_version": { "const": "0.1.0" },
        "viewport_capture_id": { "type": "string" },
        "viewport_name": { "type": "string" },
        "page_entity_id": { "type": "string" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "entity": {
      "type": "object",
      "required": ["ontology_entity_id", "entity_type", "taxonomy_id", "label", "viewport_capture_id", "source_node_id", "parent_entity_id", "confidence", "method", "layer", "evidence", "attributes"],
      "properties": {
        "ontology_entity_id": { "type": "string", "pattern": "^ont_[a-f0-9]{20}$" },
        "entity_type": { "enum": ["page", "region", "section", "component", "element", "content", "ux_pattern"] },
        "taxonomy_id": { "type": "string", "pattern": "^dig:(page|region|section|component|element|content|pattern)\\." },
        "label": { "type": "string" },
        "viewport_capture_id": { "type": "string" },
        "source_node_id": { "type": ["string", "null"] },
        "logical_element_id": { "type": "string" },
        "parent_entity_id": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" },
        "layer": { "enum": ["L2", "L3"] },
        "evidence": { "type": "array", "items": { "type": "object", "required": ["kind", "fact", "value"] } },
        "attributes": { "type": "object" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["relationship_id", "type", "from_entity_id", "to_entity_id", "confidence", "layer"],
      "properties": {
        "relationship_id": { "type": "string" },
        "type": { "enum": ["contains", "implements", "labels"] },
        "from_entity_id": { "type": "string" },
        "to_entity_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "layer": { "enum": ["L2", "L3"] }
      }
    }
  }
}
