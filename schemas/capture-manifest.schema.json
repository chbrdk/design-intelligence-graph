{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/capture-manifest.schema.json",
  "title": "DIG-001 Capture Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capture_run_id", "started_at", "completed_at", "requested_url",
    "canonical_url", "site", "page", "crawler", "browser", "environment", "capture_dimensions", "policy", "status", "capture_status", "run_artifacts",
    "viewport_captures", "interventions", "errors"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "capture_run_id": { "type": "string", "pattern": "^cap_[a-f0-9]{32}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "requested_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "canonical_url": { "type": "string", "format": "uri" },
    "site": {
      "type": "object", "required": ["site_id", "domain", "scheme", "canonical_origin"],
      "properties": { "site_id": { "type": "string" }, "domain": { "type": "string" }, "scheme": { "enum": ["http", "https"] }, "canonical_origin": { "type": "string", "format": "uri" } }
    },
    "page": {
      "type": "object", "required": ["page_id", "site_id", "url", "canonical_url", "route"],
      "properties": { "page_id": { "type": "string" }, "site_id": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "canonical_url": { "type": "string", "format": "uri" }, "route": { "type": "string" } }
    },
    "crawler": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": { "name": { "const": "dig-capture" }, "version": { "type": "string" } }
    },
    "browser": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "version", "user_agent", "locale", "timezone"],
      "properties": {
        "engine": { "const": "chromium" }, "version": { "type": "string" },
        "user_agent": { "type": "string" }, "locale": { "type": "string" }, "timezone": { "type": "string" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["prefers_color_scheme", "prefers_reduced_motion", "forced_colors", "touch", "pointer", "hover"],
      "properties": {
        "prefers_color_scheme": { "enum": ["light", "dark"] }, "prefers_reduced_motion": { "type": "boolean" },
        "forced_colors": { "type": "boolean" }, "touch": { "type": "boolean" },
        "pointer": { "enum": ["fine", "coarse", "none"] }, "hover": { "type": "boolean" }
      }
    },
    "capture_dimensions": { "type": "object", "required": ["locale", "market", "theme", "consent_state", "authentication_state", "personalization", "experiments"] },
    "policy": { "type": "object", "required": ["authorization_basis", "robots_decision", "retention_class", "redistribution_class"] },
    "status": { "$ref": "#/$defs/status" },
    "capture_status": { "type": "object", "additionalProperties": { "$ref": "#/$defs/status" } },
    "run_artifacts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifact" } },
    "viewport_captures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewportCapture" } },
    "interventions": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "status": { "enum": ["complete", "partial", "failed", "not_attempted", "unsupported", "blocked"] },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "media_type"],
      "properties": {
        "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }, "media_type": { "type": "string" }
      }
    },
    "viewportCapture": {
      "type": "object",
      "required": ["viewport_capture_id", "name", "viewport", "document", "final_url", "title", "started_at",
        "completed_at", "status", "node_count", "visible_node_count", "text_line_count", "artifacts", "warnings", "quality"],
      "properties": {
        "viewport_capture_id": { "type": "string", "pattern": "^vpc_[a-f0-9]{32}$" },
        "name": { "type": "string" },
        "viewport": {
          "type": "object", "required": ["width", "height", "device_scale_factor"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "device_scale_factor": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "document": {
          "type": "object", "required": ["width", "height"],
          "properties": { "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 } }
        },
        "final_url": { "type": "string" }, "title": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" }, "completed_at": { "type": "string", "format": "date-time" },
        "status": { "$ref": "#/$defs/status" }, "node_count": { "type": "integer", "minimum": 0 },
        "visible_node_count": { "type": "integer", "minimum": 0 }, "text_line_count": { "type": "integer", "minimum": 0 },
        "artifacts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/artifact" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "quality": {
          "type": "object", "required": ["formula_version", "overall", "rating", "metrics", "weights"],
          "properties": {
            "formula_version": { "const": "0.2.0" },
            "overall": { "type": "number", "minimum": 0, "maximum": 1 },
            "rating": { "enum": ["excellent", "good", "partial", "poor"] },
            "metrics": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
            "weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        }
      }
    },
    "error": {
      "type": "object", "required": ["code", "message"],
      "properties": { "viewport": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
