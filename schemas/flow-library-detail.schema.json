{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/flow-library-detail.schema.json",
  "title": "DIG-011 Library Flow Detail (planned)",
  "type": "object",
  "required": ["schema_version", "flow"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "flow": { "type": "object" },
    "media": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "primary_image_path": { "type": ["string", "null"] },
          "checkion_scan_id": { "type": ["string", "null"] }
        }
      }
    },
    "screen_analyses": {
      "type": "array",
      "description": "Per-step single-screen analysis SSOT + flow_context",
      "items": { "type": "object" }
    },
    "analysis_coverage": {
      "type": "object",
      "properties": {
        "screens": { "type": "integer" },
        "with_summary": { "type": "integer" },
        "with_patterns": { "type": "integer" },
        "complete_status": { "type": "integer" }
      }
    }
  }
}
