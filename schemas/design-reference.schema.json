{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/design-reference.schema.json",
  "title": "DIG-012 Design Reference",
  "type": "object",
  "required": [
    "schema_version",
    "reference_id",
    "capture_run_id",
    "scope",
    "taxonomy",
    "composition",
    "look",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "reference_id": { "type": "string" },
    "capture_run_id": { "type": "string" },
    "scope": { "enum": ["section", "screen"] },
    "section_id": { "type": ["string", "null"] },
    "viewport_capture_id": { "type": ["string", "null"] },
    "taxonomy": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": { "type": "string" },
        "taxonomy_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "screen_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "composition": {
      "type": "object",
      "required": ["signature", "stack_summary"],
      "properties": {
        "signature": { "type": "string" },
        "stack_summary": { "type": "string", "maxLength": 200 },
        "gaps_px": {
          "type": "array",
          "items": { "type": "number" }
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "look": {
      "type": "object",
      "required": ["look_summary", "confidence"],
      "properties": {
        "look_summary": { "type": "string", "maxLength": 400 },
        "interaction_summary": { "type": "string" },
        "background": { "type": "object" },
        "overlay": { "type": "object" },
        "shadows": { "type": "object" },
        "typography_emphasis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alignment": { "type": "object" },
        "media": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["hex"],
            "properties": {
              "hex": { "type": "string" },
              "roles": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "typography": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "family": { "type": "string" },
              "size": { "type": "string" },
              "weight": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "radii": {
          "type": "array",
          "items": { "type": "string" }
        },
        "style_labels": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "page_context": {
      "type": "object",
      "properties": {
        "visual_style_labels": { "type": "array", "items": { "type": "string" } },
        "design_summary": { "type": "string" }
      }
    },
    "flow_context": {
      "type": "object",
      "properties": {
        "flow_action_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^dig:flow\\." }
        },
        "prev_screen_id": { "type": ["string", "null"] },
        "next_screen_id": { "type": ["string", "null"] }
      }
    },
    "media_ref": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["viewport", "full_page", "section_crop", "none"] },
        "path": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["evidence_refs", "methods"],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "maxItems": 24,
          "items": { "type": "string" }
        },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "layers": {
          "type": "array",
          "items": { "enum": ["L1", "L2", "L3"] }
        }
      }
    }
  }
}
