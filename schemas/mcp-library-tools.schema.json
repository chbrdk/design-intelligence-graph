{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/mcp-library-tools.schema.json",
  "title": "DIG MCP Library loop tools",
  "description": "Screen facet search + capture prompt pack for agents. Names live in knowledge/paths.json mcpLibraryTools.",
  "type": "object",
  "required": ["name", "description", "inputSchema"],
  "properties": {
    "name": {
      "enum": ["dig_screen_search", "dig_capture_prompt_pack"]
    },
    "description": { "type": "string" },
    "inputSchema": { "type": "object" }
  },
  "$defs": {
    "dig_screen_search_input": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "layout": { "type": "string" },
        "industry": { "type": "string" },
        "platformProjectId": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "dig_capture_prompt_pack_input": {
      "type": "object",
      "required": ["capture_run_id"],
      "properties": {
        "capture_run_id": { "type": "string" },
        "brief": { "type": "string" },
        "platformProjectId": { "type": "string" },
        "output_contract": {
          "enum": ["layout_hints_json", "prose_brief", "both"]
        }
      }
    }
  }
}
