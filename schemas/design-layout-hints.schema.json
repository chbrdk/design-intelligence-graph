{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/design-layout-hints.schema.json",
  "title": "DIG-012 Layout Hints JSON (LLM output contract)",
  "type": "object",
  "required": [
    "primary_reference_id",
    "proposed_signature",
    "block_plan",
    "token_hints",
    "look_directives",
    "cited_reference_ids"
  ],
  "properties": {
    "primary_reference_id": { "type": "string" },
    "proposed_signature": { "type": "string" },
    "block_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string" },
          "notes": { "type": "string" },
          "alignment": { "type": "string" },
          "emphasis": { "type": "string" }
        }
      }
    },
    "token_hints": {
      "type": "object",
      "properties": {
        "accent": { "type": "string" },
        "foreground": { "type": "string" },
        "background": { "type": "string" },
        "radius": { "type": "string" },
        "type_display": { "type": "string" }
      }
    },
    "look_directives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "avoid": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cited_reference_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
