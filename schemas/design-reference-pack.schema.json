{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/design-reference-pack.schema.json",
  "title": "DIG-012 Design Reference Pack",
  "type": "object",
  "required": ["schema_version", "intent", "references", "synthesis_mode"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "intent": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "object" }
    },
    "synthesis_mode": {
      "enum": ["structural", "look_conditioned"]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "viewport": { "enum": ["mobile", "tablet", "desktop"] },
        "must_include_taxonomy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbid_source_copy": { "type": "boolean" }
      }
    }
  }
}
