{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence-graph.dev/schemas/0.1.0/design-prompt-pack.schema.json",
  "title": "DIG-012 Design Prompt Pack",
  "type": "object",
  "required": ["schema_version", "role", "brief", "rules", "references", "ask", "output_contract"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "role": { "const": "design_synthesis" },
    "brief": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "object" }
    },
    "ask": { "type": "string", "minLength": 1 },
    "output_contract": {
      "enum": ["layout_hints_json", "prose_brief", "both"]
    },
    "look_contract": {
      "type": "object",
      "description": "Hard measured look constraints (colors, type, radius, CTA, avoid).",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "look_contract_version": { "type": "string" },
        "colors": {
          "type": "object",
          "properties": {
            "bg": { "type": ["string", "null"] },
            "ink": { "type": ["string", "null"] },
            "accent": { "type": ["string", "null"] }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "display": { "type": ["string", "null"] },
            "body": { "type": ["string", "null"] }
          }
        },
        "radius_px": { "type": ["number", "null"] },
        "cta_chrome": { "type": ["string", "null"] },
        "density": { "type": ["string", "null"] },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual_craft": {
      "type": "object",
      "description": "Reconstruction-grade type/image/space craft for LLM rebuilds.",
      "properties": {
        "type_image_relationship": { "type": "string" },
        "typography_composition": { "type": "string" },
        "imagery_craft": { "type": "string" },
        "spatial_craft": { "type": "string" },
        "chrome_vs_content": { "type": "string" },
        "rebuild_spec": { "type": "string" }
      }
    },
    "page_rhythm": {
      "type": "object",
      "description": "Measured vertical page order (arc, above-fold recipe, bands).",
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "page_rhythm_version": { "type": "string" },
        "page_arc": { "type": "string" },
        "above_fold": {
          "type": "object",
          "properties": {
            "ingredients": { "type": "array", "items": { "type": "string" } },
            "summary": { "type": "string" },
            "height": { "type": ["number", "null"] }
          }
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone": { "enum": ["above_fold", "mid", "below"] },
              "category": { "type": "string" },
              "signature": { "type": ["string", "null"] },
              "beat": { "type": ["string", "null"] },
              "height": { "type": "number" }
            }
          }
        },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
